      "html": "<div class=\"ds-surface\"><button class=\"ds-row\"><span class=\"ds-glyph\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M2 10h20\"/></svg></span><span class=\"ds-copy\"><strong>银行卡管理</strong><span>查看卡片状态与支付限额</span></span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m9 18 6-6-6-6\"/></svg></button></div>",
      "css": ".ds-surface{background:#fff;border:1px solid var(--line,#e4ebe8);border-radius:var(--radius,16px)}.ds-row{display:flex;align-items:center;gap:13px;width:100%;padding:17px 18px;text-align:left;border:0;border-radius:16px;background:transparent;color:var(--ink,#142b38);font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;cursor:pointer;transition:background .18s}.ds-row:hover{background:#f3f8f6}.ds-row:focus-visible{outline:3px solid var(--focus,#68aab0);outline-offset:4px}.ds-row:active{filter:brightness(.96)}.ds-glyph{width:43px;height:43px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#edf6f4;color:#377781;flex-shrink:0}.ds-copy{flex:1;min-width:0}.ds-copy strong{display:block;font-size:13px;font-weight:550;line-height:1.55}.ds-copy>span{display:block;font-size:11px;color:var(--muted,#61757d);margin-top:4px;line-height:1.6}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
    }
