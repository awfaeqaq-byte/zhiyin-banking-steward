    {
      "name": "Selected navigation",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "桌面主导航的选中状态；图标与文字同时标识入口。",
      "html": "<nav aria-label=\"主导航\"><button class=\"ds-nav\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z\"/></svg>管家<i></i></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:15px;width:184px;padding:15px 19px;text-align:left;border:0;border-radius:12px;background:#dfece5;color:var(--teal-dark,#14545c);font:600 15px \"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;cursor:pointer;transition:background .18s}.ds-nav:hover{background:#dfece5}.ds-nav:focus-visible{outline:3px solid var(--focus,#68aab0);outline-offset:4px}.ds-nav:active{filter:brightness(.96)}.ds-nav i{width:5px;height:5px;border-radius:50%;background:var(--teal,#206a70);margin-left:auto}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
