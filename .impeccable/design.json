  "components": [
    {
      "name": "Funding forecast window",
      "kind": "input",
      "description": "近期资金安排的原生 7／14／30 天单选窗口，默认 7 天；保留键盘操作、44px 触控区域和选中焦点。预览只展示窗口控件，不运行资金测算。",
      "html": "<div class=\"ds-funding-horizon\" role=\"radiogroup\" aria-label=\"选择资金测算窗口\"><label><input type=\"radio\" name=\"ds-funding-horizon\" checked /><span>未来 7 天</span></label><label><input type=\"radio\" name=\"ds-funding-horizon\" /><span>未来 14 天</span></label><label><input type=\"radio\" name=\"ds-funding-horizon\" /><span>未来 30 天</span></label></div>",
      "css": ".ds-funding-horizon{display:flex;flex-wrap:wrap;gap:4px;width:fit-content;padding:4px;background:var(--pale,#eaf4f3);border-radius:12px;color:var(--ink,#142b38);font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif}.ds-funding-horizon label{position:relative;cursor:pointer}.ds-funding-horizon input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.ds-funding-horizon span{display:flex;align-items:center;box-sizing:border-box;min-height:44px;padding:8px 14px;border-radius:9px;font-size:13px;transition:background 160ms,color 160ms}.ds-funding-horizon input:checked+span{background:var(--teal,#206a70);color:var(--paper,#fff)}.ds-funding-horizon input:focus-visible+span{outline:2px solid var(--teal,#206a70);outline-offset:3px}.ds-funding-horizon label:hover span{box-shadow:inset 0 0 0 1px var(--teal,#206a70)}@media(max-width:540px){.ds-funding-horizon{justify-content:space-between}.ds-funding-horizon span{padding:8px 10px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-funding-horizon span{transition:none}}"
    },
    {
      "name": "Connected provider source",
      "kind": "card",
      "refersTo": "provider-source",
      "description": "设置内只读来源卡：脱敏账号与授权项数；余额仅在可用时展示，不展示同步时间。重新授权会进入知银确认与合作方确认两步流程，断开为独立动作。预览数据仅为状态示例。",
      "html": "<section class=\"ds-provider\"><div class=\"ds-provider-main\"><span class=\"ds-provider-mark\" aria-hidden=\"true\">微</span><div class=\"ds-provider-copy\"><div class=\"ds-provider-title\"><h3>微信支付</h3><span class=\"ds-provider-status\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg>已连接</span></div><p>演示账号 ***8888 · 已授权 3 项</p></div></div><div class=\"ds-provider-actions\"><button type=\"button\">重新授权</button><button type=\"button\">断开连接</button></div></section>",
      "css": ".ds-provider{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;color:var(--ink,#142b38);border:1px solid var(--line,#e4ebe8);border-radius:15px;background:var(--paper,#fff);overflow:hidden}.ds-provider-main{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:12px;padding:17px 18px}.ds-provider-mark{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;color:#fff;background:#07c160;font-size:18px;font-weight:700}.ds-provider-copy{min-width:0}.ds-provider-title{display:flex;align-items:center;gap:9px}.ds-provider-title h3{margin:0;font-size:15px}.ds-provider-copy p{margin:4px 0 0;color:var(--muted,#61757d);font-size:12px;line-height:1.5}.ds-provider-copy small{display:block;margin-top:3px;color:#77898e;font-size:10px}.ds-provider-status{display:inline-flex;align-items:center;gap:3px;padding:2px 6px;border-radius:20px;background:#e4f5ed;color:#247556;font-size:10px;font-weight:600}.ds-provider-actions{display:grid;grid-template-columns:1fr 1fr;min-height:45px;border-top:1px solid var(--line,#e4ebe8)}.ds-provider-actions button{display:flex;align-items:center;justify-content:center;gap:6px;border:0;background:#fbfdfc;color:#4f686f;font:12px \"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;cursor:pointer}.ds-provider-actions button+button{border-left:1px solid var(--line,#e4ebe8);color:#8b4d50}.ds-provider-actions button:focus-visible{outline:3px solid #68aab0;outline-offset:4px}.ds-provider-actions button:active{filter:brightness(.96)}@media(max-width:640px){.ds-provider-main{padding:15px}}"
    },
    {
      "name": "Scoped read consent",
      "kind": "input",
      "refersTo": "consent-scope",
      "description": "授权面板的独立读取范围行，包含用途说明、勾选状态和整行键盘焦点。",
      "html": "<fieldset class=\"ds-scopes\"><legend>允许读取</legend><label><input type=\"checkbox\" checked/><span><strong>读取账户余额</strong><small>用于计算当前可支配资金</small></span><span class=\"ds-scope-check\" aria-hidden=\"true\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span></label><label><input type=\"checkbox\"/><span><strong>读取自动扣费</strong><small>用于识别未来确定支出</small></span><span class=\"ds-scope-check\" aria-hidden=\"true\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span></label></fieldset>",
      "css": ".ds-scopes{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;color:var(--ink,#142b38);margin:20px 0;padding:0;border:0}.ds-scopes legend{margin-bottom:9px;font-size:12px;font-weight:600;color:var(--muted,#61757d)}.ds-scopes label{display:grid;grid-template-columns:1fr 22px;align-items:center;gap:10px;min-height:67px;padding:11px 3px;border-bottom:1px solid var(--line,#e4ebe8);cursor:pointer}.ds-scopes input{position:absolute;opacity:0;pointer-events:none}.ds-scopes strong,.ds-scopes small{display:block}.ds-scopes strong{font-size:14px}.ds-scopes small{margin-top:3px;color:var(--muted,#61757d);font-size:11px}.ds-scope-check{display:grid;place-items:center;width:21px;height:21px;border:1px solid #b8cbc7;border-radius:6px;color:transparent}.ds-scopes input:checked~.ds-scope-check{border-color:var(--teal,#206a70);background:var(--teal,#206a70);color:#fff}.ds-scopes label:focus-within{outline:2px solid var(--teal,#206a70);outline-offset:2px}"
    },
    {
      "name": "Button / primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "当前按钮变体；相同尺寸、焦点和禁用处理。",
      "html": "<button class=\"ds-button-primary\">核对转账方案</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--teal,#206a70);color:#fff;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:13px;font-weight:500;line-height:1.5;border:1px solid transparent;border-radius:10px;padding:12px 18px;min-height:44px;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s}.ds-button-primary:hover{background:var(--teal-dark,#14545c)}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#68aab0);outline-offset:4px}.ds-button-primary:active:not(:disabled){filter:brightness(.96)}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed}@media(max-width:640px){.ds-button-primary{min-height:47px}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Button / secondary",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "当前按钮变体；相同尺寸、焦点和禁用处理。",
      "html": "<button class=\"ds-button-secondary\">返回修改</button>",
