      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:12px;color:#536f62;margin-bottom:18px}.ds-field input{background:#fff;border:1px solid #ceddd4;border-radius:9px;padding:12px;height:47px;color:var(--ink,#142b38);font:15px \"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;caret-color:var(--teal,#206a70)}.ds-field input:focus-visible{outline:3px solid var(--focus,#68aab0);outline-offset:4px}.ds-field input:read-only{background:#f0f4ef;color:#476657;border-color:transparent}@media(max-width:640px){.ds-field input{font-size:16px}}"
